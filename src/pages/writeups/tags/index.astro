---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getChallenges } from '../../../utils/content';

const challenges = await getChallenges(
  ({ data }) => data.draft !== true
);

const tags = [
  ...new Set(
    challenges.flatMap((challenge) => 
      (challenge.data.tags as string[])
        .filter((tag) => typeof tag === 'string' && tag.trim())
        .map((tag) => `#${tag.trim().toLowerCase()}`)
    )
  ),
];

const pageTitle = 'All Tags';
const pageDescription = 'Browse all tags used in events.';
---

<PageLayout title={pageTitle} description={pageDescription}>
  <div class="flex flex-col gap-4">
    <h1 class="text-3xl font-bold">Tags</h1>
    <p class="text-md">Explore all tags used across events.</p>
    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/writeups/tags/${tag?.slice(1)}`}
              class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui"
            >
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</PageLayout>
