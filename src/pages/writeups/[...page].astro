---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
// import Button from '../../components/core/Button.astro';
import EventCard from '../../components/CardEvent.astro';
import Pagination from '../../components/Pagination.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getEvents } from '../../utils/content';
import { determineCardEdgeClasses } from '../../utils/helper';
// import Search from '../../components/Search.astro';

export async function getStaticPaths({
  paginate,
}: {
  paginate: (paths: any[], options: { pageSize: number }) => any;
}) {
  const eventCollections = await getEvents(
    (event) => event.data.start !== undefined || event.data.end !== undefined
  );
  return paginate(eventCollections, { pageSize: 10 });
}

interface Props {
  page: Page;
}

const { page } = Astro.props as Props;

const groupedEvents = page.data.reduce((acc, event) => {
  const year = new Date(event.data.start).getFullYear();

  if (!acc.has(year)) {
    acc.set(year, []);
  }

  acc.get(year)!.push(event);
  return acc;
}, new Map<string, any[]>());
---

<PageLayout title="Writeups">
  <div class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold">Writeups</h1>
    <div class="flex flex-col gap-4">
      {
        groupedEvents.size === 0 && (
          <p class="text-flexoki-light-tx-2 dark:text-flexoki-dark-tx-2">
            No writeups found.
          </p>
        )
      }

      <!-- <div class="flex flex-row gap-2 justify-between">
        <Search placeholder="Search writeups..." class="flex-1" />
        <div class="flex flex-row gap-2">
          <Button variant="secondary" size="sm" href="/writeups/years">
            Browse by Year
          </Button>
          <Button variant="secondary" size="sm" href="/writeups/categories">
            Browse by Categories
          </Button>
          <Button variant="secondary" size="sm" href="/writeups/tags">
            Browse by Tags
          </Button>
        </div>
      </div> -->

      {
        [...groupedEvents.entries()].map(([date, events]) => (
          <div class="flex flex-col gap-2">
            <div class="flex flex-row items-center justify-between gap-1 px-4">
              <h2 class="text-lg font-semibold">{date}</h2>
              {/* <span class="flex-1 w-full h-[0.1rem] bg-flexoki-light-ui dark:bg-flexoki-dark-ui" />
              <p>{events.length} Competitions</p> */}
            </div>
            <div class="grid md:grid-cols-1 gap-1">
              {events.map((event: CollectionEntry<'events'>, index: number) => (
                <EventCard
                  event={event}
                  href={`/writeups/${event.id.split('/').slice(0, -1).join('/')}`}
                  class:list={[
                    'rounded-none',
                    `${determineCardEdgeClasses(index, events.length, 1)}`,
                  ]}
                />
              ))}
            </div>
          </div>
        ))
      }

      {
        page.lastPage !== 1 && (
          <div class="flex gap-1 justify-end">
            <Pagination page={page} />
          </div>
        )
      }
    </div>
  </div>
</PageLayout>
