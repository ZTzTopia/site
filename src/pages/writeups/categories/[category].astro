---
import { Icon } from 'astro-icon/components';
import CardChallenge from '../../../components/CardChallenge.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getChallenges } from '../../../utils/content';
import {
  determineCardEdgeClasses,
  getBackgroundColorByCategory,
  getIconByCategory,
  normalizeCategoryName,
} from '../../../utils/helper';

export async function getStaticPaths() {
  const challenges = await getChallenges(({ data }) => data.draft !== true);

  const seen = new Set<string>();
  const paths = [];

  for (const challenge of challenges) {
    const category = challenge.id.split('/')[2];

    // `_` is the "no category folder" placeholder, not a real category
    if (!category || category === '_' || seen.has(category)) {
      continue;
    }

    seen.add(category);
    paths.push({ params: { category } });
  }

  return paths;
}

interface Params {
  category: string;
}

const { category } = Astro.params as Params;

const challenges = await getChallenges(
  ({ id, data }) => id.split('/')[2] === category && data.draft !== true
);

const name = normalizeCategoryName(category);

const pageTitle = `${name} Writeups`;
const pageDescription = `A collection of ${name.toLowerCase()} challenge writeups across all CTF competitions.`;
---

<PageLayout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="flex flex-col gap-4">
    <div class="flex flex-row flex-wrap items-center gap-2">
      <h1 class="text-3xl font-bold">{name}</h1>
      <span
        class={`flex flex-row items-center gap-x-1 text-xs font-medium px-2.5 py-0.5 rounded ${getBackgroundColorByCategory(category)}`}
      >
        <Icon name={getIconByCategory(category)} />
        {challenges.length} writeup{challenges.length === 1 ? '' : 's'}
      </span>
    </div>
    <div class="grid md:grid-cols-3 gap-1">
      {
        challenges.length === 0 ? (
          <p>No writeups found :(</p>
        ) : (
          challenges.map((challenge, index) => (
            <CardChallenge
              event={challenge}
              href={`/writeups/${challenge.id}`}
              class:list={[
                'challenge-card',
                'rounded-none',
                determineCardEdgeClasses(index, challenges.length, 1),
                'md:rounded-none',
                determineCardEdgeClasses(index, challenges.length, 3, 'md'),
              ]}
              data-categories={challenge.data.categories.join(',')}
            />
          ))
        )
      }
    </div>
  </div>
</PageLayout>
