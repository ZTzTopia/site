---
import CardChallenge from '../../../../../components/CardChallenge.astro';
import PageLayout from '../../../../../layouts/PageLayout.astro';
import { getChallenges, getEvents } from '../../../../../utils/content';
import { determineCardEdgeClasses, normalizeCategoryName } from '../../../../../utils/helper';

export async function getStaticPaths() {
  const challenges = await getChallenges(
    ({ data }) => data.draft !== true
  );
  const paths = challenges.map((challenge) => {
    const slugs = challenge.id.split('/');
    return {
      params: {
        year: slugs[0],
        event: slugs[1],
        category: slugs[2],
      },
    };
  });

  return paths;
}

interface Params {
  year: string;
  event: string;
  category: string;
}

const params = Astro.params as Params;

const event = (await getEvents(
  ({ id }) => id.startsWith(`${params.year}/${params.event}`)
))[0];

if (!event) {
  throw new Error(`Event not found: ${params.year}/${params.event}`);
}

const challenges = await getChallenges(
  ({ id, data }) =>
    id.startsWith(`${params.year}/${params.event}/${params.category}`) &&
    data.draft !== true
);

const title = `${normalizeCategoryName(params.category)} Challenges - ${event.data.title} Writeups`;
const description = `A collection of writeups for ${normalizeCategoryName(params.category)} challenges at ${event.data.title}.`;
---

<PageLayout
  title={title}
  description={description}
  noindex={true}
>
  <div class="flex flex-col gap-4">
    <h1 class="text-4xl font-bold">{params.category}</h1>
    <div class="flex flex-col gap-4">
      <div class="grid md:grid-cols-3 gap-1">
        {
          challenges.length === 0 ? (
            <p>No challenges found :(</p>
          ) : (
            challenges.map((eventChallenge, index) => (
              <CardChallenge
                event={eventChallenge}
                href={`/writeups/${eventChallenge.id.split('/').slice(0, -1).join('/')}`}
                class:list={[
                  'challenge-card',
                  'rounded-none',
                  determineCardEdgeClasses(index, challenges.length, 1),
                  'md:rounded-none',
                  determineCardEdgeClasses(index, challenges.length, 3, 'md'),
                ]}
              />
            ))
          )
        }
      </div>
    </div>
  </div>
</PageLayout>
