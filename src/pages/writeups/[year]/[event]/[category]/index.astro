---
import { getCollection } from 'astro:content';
import CardChallenge from '../../../../../components/CardChallenge.astro';
import PageLayout from '../../../../../layouts/PageLayout.astro';
import { getEventChallenges } from '../../../../../utils/content';
import { determineCardEdgeClasses } from '../../../../../utils/helper';

export async function getStaticPaths() {
  const challenges = await getEventChallenges(
    ({ data }) => data.draft !== true
  );
  const paths = challenges.map((event) => {
    const slugs = event.id.split('/');
    return {
      params: {
        year: slugs[0],
        event: slugs[1],
        category: slugs[2],
      },
      props: {
        event,
      },
    };
  });

  return paths;
}

interface Params {
  year: string;
  event: string;
  category: string;
}

// interface Props {
//   event: CollectionEntry<'events'>;
// }

const params = Astro.params as Params;
// const props: Props = Astro.props;

const challenges = await getCollection(
  'challenges',
  ({ id, data }) =>
    id.split('/')[0] === params.year &&
    id.split('/')[1] === params.event &&
    id.split('/')[2] === params.category &&
    data.draft !== true
);
---

<PageLayout title="Writeups" type="article">
  <div class="flex flex-col gap-4">
    <h1 class="text-4xl font-bold">{params.category}</h1>
    <div class="flex flex-col gap-4">
      <div class="grid md:grid-cols-3 gap-1">
        {
          challenges.length === 0 ? (
            <p>No challenges found :(</p>
          ) : (
            challenges.map((eventChallenge, index) => (
              <CardChallenge
                event={eventChallenge}
                href={`/writeups/${eventChallenge.id.split('/').slice(0, -1).join('/')}`}
                class:list={[
                  'challenge-card',
                  'rounded-none',
                  determineCardEdgeClasses(index, challenges.length, 1),
                  'md:rounded-none',
                  determineCardEdgeClasses(index, challenges.length, 3, 'md'),
                ]}
              />
            ))
          )
        }
      </div>
    </div>
  </div>
</PageLayout>
