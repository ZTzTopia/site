---
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import { render, type CollectionEntry } from 'astro:content';
import CardIcon from '../../../../../components/CardIcon.astro';
import Card from '../../../../../components/Core/Card.astro';
import BlogLayout from '../../../../../layouts/BlogLayout.astro';
import {
  getBackgroundColorByCategory,
  getIconByCategory,
} from '../../../../../utils/color-icon';
import { getChallenges, getEvents } from '../../../../../utils/content';
import { determineCardEdgeClasses, normalizeCategoryName } from '../../../../../utils/helper';
import Link from '../../../../../components/Core/Link.astro';

export async function getStaticPaths() {
  const challenges = await getChallenges(
    ({ data }) => data.draft !== true
  );
  const paths = challenges.map((challenge) => {
    const slugs = challenge.id.split('/');
    return {
      params: {
        year: slugs[0],
        event: slugs[1],
        category: slugs[2],
        challenge: slugs[3],
      },
      props: {
        challenge,
      },
    };
  });

  return paths;
}

interface Params {
  year: string | undefined;
  event: string | undefined;
  category: string | undefined;
  challenge: string | undefined;
}

interface Props {
  challenge: CollectionEntry<'challenges'>;
}

const params: Params = Astro.params;
const props: Props = Astro.props;

const renderedChallenge = await render(props.challenge);
const headings: MarkdownHeading[] = renderedChallenge.headings;

const categories = [
  ...new Set(
    (props.challenge.data.categories as string[])
      .filter((category) => typeof category === 'string' && category.trim())
      .map((category) => category.trim())
  ),
];

const tags = [
  ...new Set(
    (props.challenge.data.tags as string[])
      .filter((tag) => typeof tag === 'string' && tag.trim())
      .map((tag) => `#${tag.trim().toLowerCase()}`)
  ),
];

const event = (await getEvents(
  ({ id }) => id.startsWith(`${params.year}/${params.event}`)
))[0];

if (!event) {
  throw new Error(`Event not found: ${params.year}/${params.event}`);
}

const title = `${props.challenge.data.title} - ${event.data.title} Writeup`;
const description = props.challenge.data.description || `Writeup for ${props.challenge.data.title} challenge at ${event.data.title}.`;
---

<BlogLayout
  title={title}
  description={description}
  type="article"
  {headings}
>
  {
    categories.length > 0 && (
      <div class="flex flex-row flex-wrap gap-2">
        {categories.map((category) => (
          // FIXME: Link to proper category page when there is more than one
          // category per challenge, but since the challenge is in one category
          // folder already, why need multiple of categories? isn't tags enough?
          <Link href={`/writeups/${params.year}/${params.event}/${params.category}`} class="not-prose">
            <span
              class={`flex flex-row items-center gap-x-1 text-xs font-medium px-2.5 py-0.5 rounded ${getBackgroundColorByCategory(category)}`}
            >
              <Icon name={getIconByCategory(category)} />
              {normalizeCategoryName(category)}
            </span>
          </Link>
        ))}

        {props.challenge.data.blooded && (
          <span class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded text-flexoki-dark-tx dark:text-flexoki-light-tx bg-flexoki-light-re dark:bg-flexoki-dark-re">
            <Icon name="lucide:droplet" />
            First Blood
          </span>
        )}
      </div>
    )
  }

  <h1 class="text-4xl font-bold mt-2" id="_halll">
    {props.challenge.data.title}
  </h1>

  <p>
    {props.challenge.data.description}
  </p>

  <div class="flex flex-col gap-2">
    <div class="not-prose grid md:grid-cols-2 gap-1">
      {params.year === '_' ? (
        <CardIcon
          icon='lucide:link'
          class:list="col-span-3"
        >
          <p class="flex flex-col text-sm">
            <span class="font-medium">URL</span>
            <span class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500">
              <Link href={props.challenge.data.url || 'N/A'} target="_blank" rel="noopener noreferrer">
                {props.challenge.data.url || 'N/A'}
              </Link>
            </span>
          </p>
        </CardIcon>
      ) : (
        <CardIcon
          icon="lucide:trophy"
          class:list={[
            'rounded-none',
            determineCardEdgeClasses(0, 2, 1),
            'md:rounded-none',
            determineCardEdgeClasses(0, 2, 4, 'md'),
          ]}
        >
          <p class="flex flex-col text-sm">
            <span class="font-medium">Points</span>
            <span
              class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500"
              >{props.challenge.data.points ?? 'N/A'}</span
            >
          </p>
        </CardIcon>
        <CardIcon
          icon="lucide:target"
          class:list={[
            'rounded-none',
            determineCardEdgeClasses(1, 2, 1),
            'md:rounded-none',
            determineCardEdgeClasses(1, 2, 4, 'md'),
          ]}
        >
          <p class="flex flex-col text-sm">
            <span class="font-medium">Solves</span>
            <span
              class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500"
              >{props.challenge.data.solves ?? 'N/A'}</span
            >
          </p>
        </CardIcon>
      )}
    </div>

    {
      tags.length > 0 && (
        <div class="flex flex-row flex-wrap gap-2">
          {tags.map((tag) => (
            <Link href={`/writeups/tags/${tag?.slice(1)}`} class="not-prose">
              <span class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui">
                {tag}
              </span>
            </Link>
          ))}
        </div>
      )
    }
  </div>

  <renderedChallenge.Content />

  <Card
    class="bg-flexoki-light-bg-2 dark:bg-flexoki-dark-bg-2 items-center not-prose"
  >
    <div
      slot="content"
      class:list={[
        'flex',
        {
          'flex-row': props.challenge.data.flags.length <= 1,
          'flex-col': props.challenge.data.flags.length > 1,
        },
        'gap-2 items-center justify-center',
      ]}
    >
      {
        props.challenge.data.flags.length > 1 ? (
          props.challenge.data.flags.map((flag, i) => (
            <div class="flex items-center gap-2">
              <Icon name="lucide:flag" />
              <div class="flex-1">
                <strong>{props.challenge.data.title}</strong> Flag {i + 1}:{' '}
                <strong>
                  <code class="break-all">{flag}</code>
                </strong>
              </div>
            </div>
          ))
        ) : (
          <>
            <Icon name="lucide:flag" />
            <div class="flex-1">
              <strong>{props.challenge.data.title}</strong> Flag:{' '}
              <strong>
                <code class="break-all rounded blur-xs hover:blur-none duration-300">
                  {props.challenge.data.flags[0]}
                </code>
              </strong>
            </div>
          </>
        )
      }
    </div>
  </Card>
</BlogLayout>
