---
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import { render, type CollectionEntry } from 'astro:content';
import CardIcon from '../../../../../components/CardIcon.astro';
import Card from '../../../../../components/Core/Card.astro';
import BlogLayout from '../../../../../layouts/BlogLayout.astro';
import {
  getBackgroundColorByCategory,
  getIconByCategory,
} from '../../../../../utils/color-icon';
import { getEventChallenges } from '../../../../../utils/content';
import { determineCardEdgeClasses } from '../../../../../utils/helper';

export async function getStaticPaths() {
  const eventChallengeCollections = await getEventChallenges(
    ({ data }) => data.draft !== true
  );
  const paths = eventChallengeCollections.map((eventChallenge) => {
    const slugs = eventChallenge.id.split('/');
    return {
      params: {
        year: slugs[0],
        event: slugs[1],
        category: slugs[2],
        challenge: slugs[3],
      },
      props: {
        challenge: eventChallenge,
      },
    };
  });

  return paths;
}

interface Props {
  challenge: CollectionEntry<'challenges'>;
}

const props: Props = Astro.props;

const renderedEventChallenge = await render(props.challenge);
const headings: MarkdownHeading[] = renderedEventChallenge.headings;

const flattenedCategories = [
  ...new Set(
    (props.challenge.data.categories as string[])
      .filter((category) => typeof category === 'string' && category.trim())
      .map((category) => category.trim())
  ),
];

const flattenedTags = [
  ...new Set(
    (props.challenge.data.tags as string[])
      .filter((tag) => typeof tag === 'string' && tag.trim())
      .map((tag) => `#${tag.trim().toLowerCase()}`)
  ),
];
---

<BlogLayout title="Writeups" type="article" {headings}>
  {
    flattenedCategories.length > 0 && (
      <div class="flex flex-row flex-wrap gap-2">
        {flattenedCategories.map((category) => (
          <span
            class={`flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded ${getBackgroundColorByCategory(category)}`}
          >
            <Icon name={getIconByCategory(category)} />
            {category}
          </span>
        ))}

        {props.challenge.data.blooded && (
          <span class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded text-flexoki-dark-tx dark:text-flexoki-light-tx bg-flexoki-light-re dark:bg-flexoki-dark-re">
            <Icon name="lucide:droplet" />
            First Blood
          </span>
        )}
      </div>
    )
  }

  <h1 class="text-4xl font-bold mt-2" id="_halll">
    {props.challenge.data.title}
  </h1>

  <p>
    {props.challenge.data.description}
  </p>

  <div class="flex flex-col gap-2">
    <div class="not-prose grid md:grid-cols-2 gap-1">
      <CardIcon
        icon="lucide:trophy"
        class:list={[
          'rounded-none',
          determineCardEdgeClasses(0, 2, 1),
          'md:rounded-none',
          determineCardEdgeClasses(0, 2, 4, 'md'),
        ]}
      >
        <p class="flex flex-col text-sm">
          <span class="font-medium">Points</span>
          <span
            class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500"
            >{props.challenge.data.points}</span
          >
        </p>
      </CardIcon>

      <CardIcon
        icon="lucide:target"
        class:list={[
          'rounded-none',
          determineCardEdgeClasses(1, 2, 1),
          'md:rounded-none',
          determineCardEdgeClasses(1, 2, 4, 'md'),
        ]}
      >
        <p class="flex flex-col text-sm">
          <span class="font-medium">Solves</span>
          <span
            class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500"
            >{props.challenge.data.solves}</span
          >
        </p>
      </CardIcon>
    </div>

    {
      flattenedTags.length > 0 && (
        <div class="flex flex-row flex-wrap gap-2">
          {flattenedTags.map((tag) => (
            <span class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <renderedEventChallenge.Content />

  <Card
    class="bg-flexoki-light-bg-2 dark:bg-flexoki-dark-bg-2 items-center not-prose"
  >
    <div
      slot="content"
      class:list={[
        'flex',
        {
          'flex-row': props.challenge.data.flags.length <= 1,
          'flex-col': props.challenge.data.flags.length > 1,
        },
        'gap-2 items-center justify-center',
      ]}
    >
      {
        props.challenge.data.flags.length > 1 ? (
          props.challenge.data.flags.map((flag, i) => (
            <div class="flex items-center gap-2">
              <Icon name="lucide:flag" />
              <div class="flex-1">
                <strong>{props.challenge.data.title}</strong> Flag {i + 1}:{' '}
                <strong>
                  <code class="break-all">{flag}</code>
                </strong>
              </div>
            </div>
          ))
        ) : (
          <>
            <Icon name="lucide:flag" />
            <div class="flex-1">
              <strong>{props.challenge.data.title}</strong> Flag:{' '}
              <strong>
                <code class="break-all rounded blur-xs hover:blur-none duration-300">
                  {props.challenge.data.flags[0]}
                </code>
              </strong>
            </div>
          </>
        )
      }
    </div>
  </Card>
</BlogLayout>
