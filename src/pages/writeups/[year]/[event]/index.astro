---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import CardChallenge from '../../../../components/CardChallenge.astro';
import CardIcon from '../../../../components/CardIcon.astro';
import Chip from '../../../../components/Core/Chip.astro';
import Link from '../../../../components/Core/Link.astro';
import Prose from '../../../../components/Core/Prose.astro';
import PageLayout from '../../../../layouts/PageLayout.astro';
import { determineCardEdgeClasses, normalizeCategoryName } from '../../../../utils/helper';

export async function getStaticPaths() {
  const eventCollections = await getCollection('events');
  const paths = eventCollections.map((event) => {
    const slugs = event.id.split('/');
    return {
      params: {
        year: slugs[0],
        event: slugs[1],
      },
      props: {
        event,
      },
    };
  });

  return paths;
}

interface Params {
  year: string;
  event: string;
}

interface Props {
  event: CollectionEntry<'events'>;
}

const params = Astro.params as Params;
const props: Props = Astro.props;

const challenges = await getCollection(
  'challenges',
  ({ id, data }) =>
    id.split('/')[0] === params.year &&
    id.split('/')[1] === params.event &&
    data.draft !== true
);

const eventMeta = {
  // 'Date': { value: props.event.data.start, icon: 'lucide:calendar' },
  Location: { value: props.event.data.location, icon: 'lucide:map-pin' },
  Format: { value: props.event.data.format, icon: 'lucide:book' },
  URL: { value: props.event.data.url || 'N/A', icon: 'lucide:link' },
};

const renderedEvent = await render(props.event);

const categories = [
  ...new Set(
    challenges
      .flatMap((challenge) =>
        (challenge.data.categories as string[])
          .filter((category) => typeof category === 'string' && category.trim())
          .map((category) => category.trim())
      )
  ),
];

const title = `${props.event.data.title} Writeups`;
const description = props.event.data.description || `Writeups for ${props.event.data.title} event.`;
---

<PageLayout
  title={title}
  description={description}
  type="article"
>
  <div class="flex flex-col gap-4">
    <h1 class="text-4xl font-bold">{props.event.data.title}</h1>
    <div class="flex flex-col gap-4">
      <Prose>
        <renderedEvent.Content />
      </Prose>

      <div class="grid md:grid-cols-3 gap-1">
        {params.year === '_' ? (
          <CardIcon
            icon='lucide:link'
            class:list="col-span-3"
          >
            <p class="flex flex-col text-sm">
              <span class="font-medium">URL</span>
              <span class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500">
                <Link href={props.event.data.url || 'N/A'} target="_blank" rel="noopener noreferrer">
                  To Website
                </Link>
              </span>
            </p>
          </CardIcon>
        ) : (
          Object.entries(eventMeta).map(([key, value], index) => (
            <CardIcon
              icon={value.icon}
              class:list={[
                'rounded-none',
                determineCardEdgeClasses(
                  index,
                  Object.entries(eventMeta).length,
                  1
                ),
                'md:rounded-none',
                determineCardEdgeClasses(
                  index,
                  Object.entries(eventMeta).length,
                  3,
                  'md'
                ),
              ]}
            >
              <p class="flex flex-col text-sm">
                <span class="font-medium">{key}</span>
                <span class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500">
                  {key === 'URL' && value.value !== 'N/A' ? (
                    <Link href={value.value} target="_blank" rel="noopener noreferrer">
                      To Website
                    </Link>
                  ) : (
                    value.value
                  )}
                </span>
              </p>
            </CardIcon>
          ))
        )}
      </div>

      <div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-medium">Filter by category:</span>
          <Chip id="filter-all" data-category="all" class="selected-filter"
            >All</Chip
          >
          {
            categories.map((category) => (
              <Chip id={`filter-${category}`} data-category={category}>
                {normalizeCategoryName(category)}
              </Chip>
            ))
          }
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-1">
        {
          challenges.length === 0 ? (
            <p>No challenges found :(</p>
          ) : (
            challenges.map((challenge, index) => {
              return (
                <CardChallenge
                  event={challenge}
                  href={`/writeups/${challenge.id.split('/').slice(0, -1).join('/')}`}
                  class:list={[
                    'challenge-card',
                    'rounded-none',
                    determineCardEdgeClasses(index, challenges.length, 1),
                    'md:rounded-none',
                    determineCardEdgeClasses(index, challenges.length, 3, 'md'),
                  ]}
                  data-categories={challenge.data.categories.join(',')}
                />
              );
            })
          )
        }
      </div>
    </div>
  </div>
</PageLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const onIdle = (cb: () => void) =>
      (window.requestIdleCallback || ((cb) => setTimeout(cb, 150)))(cb);

    onIdle(() => {
      const filterButtons = document.querySelectorAll('[data-category]');
      const cardChallenges = document.querySelectorAll('.challenge-card');
      const registeredHandlers: Array<{ button: Element; handler: (e: Event) => void }> = [];

      document.getElementById('filter-all')?.classList.add('selected-filter');

      filterButtons.forEach((button) => {
        const handler = () => {
          filterButtons.forEach((btn) => btn.classList.remove('selected-filter'));
          button.classList.add('selected-filter');

          const selectedCategory = button.getAttribute('data-category');
          if (!selectedCategory) {
            return;
          }

          cardChallenges.forEach((card: Element) => {
            if (!(card instanceof HTMLElement)) {
              return;
            }

            if (selectedCategory === 'all') {
              card.style.display = 'block';
              return;
            }

            if (selectedCategory?.length == 0) return;
            const cardCategories = card.getAttribute('data-categories')?.split(',') || [];
            card.style.display = cardCategories.includes(selectedCategory)
              ? 'block'
              : 'none';
          });
        };

        button.addEventListener('click', handler);
        registeredHandlers.push({ button, handler });
      });

      document.addEventListener('astro:before-swap', () => {
        registeredHandlers.forEach(({ button, handler }) => button.removeEventListener('click', handler));
      }, { once: true });
    });
  });
</script>
