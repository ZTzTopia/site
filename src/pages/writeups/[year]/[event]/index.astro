---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import CardChallenge from '../../../../components/CardChallenge.astro';
import PageLayout from '../../../../layouts/PageLayout.astro';
// import Prose from '../../../../components/Core/Prose.astro';
import Chip from '../../../../components/Core/Chip.astro';
// import Card from '../../../../components/Core/Card.astro';
import { determineCardEdgeClasses } from '../../../../utils/helper';
import CardIcon from '../../../../components/CardIcon.astro';

export async function getStaticPaths() {
  const eventCollections = await getCollection('events');
  const paths = eventCollections.map((event) => {
    const slugs = event.id.split('/');
    return {
      params: {
        year: slugs[0],
        event: slugs[1],
      },
      props: {
        event,
      },
    };
  });

  return paths;
}

interface Params {
  year: string;
  event: string;
}

interface Props {
  event: CollectionEntry<'events'>;
}

const params = Astro.params as Params;
const props: Props = Astro.props;

const challenges = await getCollection(
  'challenges',
  ({ id, data }) =>
    id.split('/')[0] === params.year &&
    id.split('/')[1] === params.event &&
    data.draft !== true
);

const eventMeta = {
  // 'Date': props.event.data.start,
  Location: props.event.data.location,
  Format: props.event.data.format,
  URL: props.event.data.url || 'N/A',
};

const uniqueCategories = [
  ...new Set(
    challenges
      .map((challenge) => challenge.data.categories)
      .flat()
      .filter(Boolean)
  ),
];
// const renderedEvent = await render(props.event);
---

<PageLayout title="Competition" type="article">
  <div class="flex flex-col gap-4">
    <h1 class="text-4xl font-bold">{props.event.data.title}</h1>
    <div class="flex flex-col gap-4">
      <span>{props.event.data.description}</span>

      <!-- <Prose>
        <renderedEvent.Content />
      </Prose> -->

      <!-- <Card href={props.event.data.url} target="_blank">
        <div slot="content">
          <p class="font-medium">{props.event.data.title}</p>
        </div>
      </Card> -->

      <div class="grid md:grid-cols-3 gap-1">
        {
          Object.entries(eventMeta).map(([key, value], index) => (
            <CardIcon
              class:list={[
                'rounded-none',
                determineCardEdgeClasses(
                  index,
                  Object.entries(eventMeta).length,
                  1
                ),
                'md:rounded-none',
                determineCardEdgeClasses(
                  index,
                  Object.entries(eventMeta).length,
                  3,
                  'md'
                ),
              ]}
            >
              <div>
                <p class="flex flex-col text-sm">
                  <span class="font-medium">{key}</span>
                  <span class="font-normal text-flexoki-base-600 dark:text-flexoki-base-500">{value}</span>
                </p>
              </div>
            </CardIcon>
          ))
        }
      </div>

      <div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-medium">Filter by category:</span>
          <Chip id="filter-all" data-category="all" class="selected-filter"
            >All</Chip
          >
          {
            uniqueCategories.map((category) => (
              <Chip id={`filter-${category}`} data-category={category}>
                {category}
              </Chip>
            ))
          }
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-1">
        {
          challenges.length === 0 ? (
            <p>No challenges found :(</p>
          ) : (
            challenges.map((eventChallenge, index) => {
              return (
                <CardChallenge
                  event={eventChallenge}
                  href={`/writeups/${eventChallenge.id.split('/').slice(0, -1).join('/')}`}
                  class:list={[
                    'challenge-card',
                    'rounded-none',
                    determineCardEdgeClasses(index, challenges.length, 1),
                    'md:rounded-none',
                    determineCardEdgeClasses(index, challenges.length, 3, 'md'),
                  ]}
                  data-categories={uniqueCategories.join(',')}
                />
              );
            })
          )
        }
      </div>
    </div>
  </div>
</PageLayout>

<script>
  const onIdle = (cb: IdleRequestCallback) =>
    (window.requestIdleCallback || ((cb) => setTimeout(cb, 150)))(cb);

  onIdle(() => {
    const filterButtons = document.querySelectorAll('[data-category]');
    const CardChallenges = document.querySelectorAll('.challenge-card');

    document.getElementById('filter-all')?.classList.add('selected-filter');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filterButtons.forEach((btn) => btn.classList.remove('selected-filter'));
        button.classList.add('selected-filter');

        const selectedCategory = button.getAttribute('data-category');
        if (!selectedCategory) {
          return;
        }

        CardChallenges.forEach((card: Element) => {
          if (!(card instanceof HTMLElement)) {
            return;
          }

          if (selectedCategory === 'all') {
            card.style.display = 'block';
          } else if (selectedCategory?.length > 0) {
            const cardCategories =
              card.getAttribute('data-categories')?.split(',') || [];
            card.style.display = cardCategories.includes(selectedCategory)
              ? 'block'
              : 'none';
          }
        });
      });
    });
  });
</script>
