---
import { type CollectionEntry, getCollection } from 'astro:content';
import EventCard from '../../../components/CardEvent.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getEvents } from '../../../utils/content';
import { determineCardEdgeClasses } from '../../../utils/helper';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const years = new Set<string>();

  events.forEach((event: CollectionEntry<'events'>) => {
    const slugs = event.id.split('/');
    if (slugs.length > 1) {
      const year = slugs[0];
      if (year) {
        years.add(year);
      }
    }
  });

  return [...years].map((year) => ({
    params: {
      year,
    },
  }));
}

interface Params {
  year: string;
}

const { year } = Astro.params as Params;

const events = await getEvents((event) => {
  if (!event.data.start) {
    return false;
  }

  const eventYear = new Date(event.data.start).getFullYear().toString();
  return eventYear === year;
});

const title = `Writeups from ${year} CTF Competitions`;
const description = `A collection of writeups from various CTF competitions held in ${year}.`;
---

<PageLayout 
  title={title}
  description={description}
  noindex={true}
>
  <div class="flex flex-col gap-2">
    <div class="flex flex-row items-center justify-between gap-1 ps-4">
      <h2 class="text-lg font-semibold">{year}</h2>
      <span
        class="flex-1 w-full h-[0.1rem] bg-flexoki-light-ui dark:bg-flexoki-dark-ui"
      ></span>
      <p>{events.length} Competitions</p>
    </div>
    <div class="flex flex-col gap-1">
      {
        events.length === 0 ? (
          <p>No events found :(</p>
        ) : (
          events.map((event, index) => (
            <a
              href={`/writeups/${year}/${event.id.split('/').slice(1, -1).join('/')}`}
            >
              <EventCard
                event={event}
                class:list={[
                  'rounded-none',
                  `${determineCardEdgeClasses(index, events.length, 1)}`,
                ]}
              />
            </a>
          ))
        )
      }
    </div>
  </div>
</PageLayout>
