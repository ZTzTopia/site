---
import { Image } from 'astro:assets';
import CTFTimeIcon from '../assets/ctftime.png';
import HTBIcon from '../assets/hackthebox.png';
import THMIcon from '../assets/tryhackme.png';
import MusicPresence from '../components/Activity/MusicPresence.astro';
import Card from '../components/Core/Card.astro';
import Prose from '../components/Core/Prose.astro';
import Projects from '../components/Projects.astro';
import PageLayout from '../layouts/PageLayout.astro';
// import Experience from "../components/Experience.astro";
---

<PageLayout title="Home">
  <Prose>
    <h1 class="font-medium">
      <span class="block overflow-hidden group relative">
        <span
          class="inline-block transition-transform duration-300 ease-in-out group-hover:-translate-y-full"
        >
          ztz0
        </span>
        <span
          class="inline-block transition-transform absolute left-0 top-0 duration-300 ease-in-out translate-y-full group-hover:translate-y-0"
        >
          Muhamad Zibrisky
        </span>
      </span>
    </h1>
    <p>
      I'm a full-stack developer and dedicated <a
        target="_blank"
        href="https://ctftime.org/user/209558"
        class="not-prose bg-flexoki-base-50 dark:bg-flexoki-base-950 text-xs font-medium px-2.5 py-0.5 rounded"
        ><Image
          src={CTFTimeIcon}
          alt="CTFTime"
          loading="eager"
          class="inline-block mr-1 mb-1 w-3 h-3"
        />CTF</a
      > player. I actively participate in a Capture The Flag (CTF) competitions,
      where I sharpen my skills in cybersecurity, reverse engineering, and creative
      thinking.
    </p>
    <p>
      Explore my CTF writeups on the <a
        href="/writeups"
        class="not-prose bg-flexoki-base-50 dark:bg-flexoki-base-950 text-xs font-medium px-2.5 py-0.5 rounded"
        >🚩 Writeups</a
      >. Check out my profiles on
      <a
        href="https://tryhackme.com/p/ztz"
        target="_blank"
        rel="noopener"
        class="not-prose bg-flexoki-base-50 dark:bg-flexoki-base-950 text-xs font-medium px-2.5 py-0.5 rounded ml-1"
        ><Image
          src={THMIcon}
          alt="TryHackMe"
          loading="eager"
          class="inline-block mr-1 mb-1 w-3 h-3"
        />TryHackMe</a
      > and
      <a
        href="https://app.hackthebox.com/profile/2390921"
        target="_blank"
        rel="noopener"
        class="not-prose bg-flexoki-base-50 dark:bg-flexoki-base-950 text-xs font-medium px-2.5 py-0.5 rounded ml-1"
        ><Image
          src={HTBIcon}
          alt="HackTheBox"
          loading="eager"
          class="inline-block mr-1 mb-1 w-3 h-3"
        />HackTheBox</a
      >.
    </p>
    <div class="not-prose flex flex-col md:flex-row gap-1 mt-4">
      <MusicPresence />
      <Card class="rounded-none rounded-b md:rounded-none md:rounded-r">
        <div slot="content" class="text-xs md:w-42">
          TODO: Add Experiences, Awards, Wakatime, Discord, Github, and more
          here (because someone said my website too simple).
        </div>
      </Card>
    </div>
    <h2 class="font-medium">Projects</h2>
    <div class="not-prose">
      <Projects limit={4} />
    </div>
    <!-- <p>
        I also have <a
          target="_blank"
          href=`quartz.${Astro.url.host}`
          class="not-prose bg-flexoki-base-50 dark:bg-flexoki-base-950 text-xs font-medium px-2.5 py-0.5 rounded"
          >🥬 Digital Garden</a
        > for CTF notes and other notes.
      </p>
      <h2 class="font-medium">Experiences</h2>
      <div class="not-prose">
        <Experience />
      </div> -->
  </Prose>
</PageLayout>
