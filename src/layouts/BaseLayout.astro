---
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  nofollow?: boolean;
  noindex?: boolean;
  image?: string;
  author?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Software Engineer and CTF Player from Tangerang, Indonesia',
  nofollow = false,
  noindex = false,
  image = '',
  author = '',
  type = 'website',
} = Astro.props as Props;

const navItems = [
  {
    url: '/',
    title: 'Home',
  },
  {
    url: '/writeups',
    title: 'Writeups',
  },
  {
    url: '/projects',
    title: 'Projects',
  },
];

const footerItems = [
  {
    url: 'mailto:muhzib36@gmail.com',
    title: 'Contact',
    iconName: 'lucide:mail',
  },
  {
    url: 'https://www.youtube.com/channel/ZTzTopia702',
    title: 'YouTube',
    iconName: 'lucide:youtube',
  },
  {
    url: 'https://github.com/ZTzTopia',
    title: 'GitHub',
    iconName: 'lucide:github',
  },
  {
    url: 'https://www.linkedin.com/in/muhamad-zibrisky-b6a861252/',
    title: 'LinkedIn',
    iconName: 'lucide:linkedin',
  },
];

let paths = Astro.url.pathname.split('/').map((path, index, paths) => {
  if (index === 0) {
    return {
      label: 'home',
      href: '/',
    };
  }

  if (index === paths.length - 1) {
    return {
      label: decodeURIComponent(path),
      href: Astro.url.pathname,
    };
  }

  return {
    label: decodeURIComponent(path),
    href: paths.slice(0, index + 1).join('/'),
  };
});

paths = paths.filter((path) => path.label !== '');
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      nofollow={nofollow}
      noindex={noindex}
      image={image}
      author={author}
      type={type}
    />
  </head>
  <body
    class="bg-flexoki-light-bg dark:bg-flexoki-dark-bg text-flexoki-light-tx dark:text-flexoki-dark-tx antialiased"
  >
    <div class="flex flex-col min-h-svh">
      <Header items={navItems} />

      <main class="flex-1">
        <slot name="top" />
        {
          paths.length !== 1 && (
            <Breadcrumb
              items={paths}
              class="flex flex-col p-4 mx-auto max-w-screen-md"
            />
          )
        }
        <slot />
      </main>

      <ScrollToTop />
      <Footer items={footerItems} />
    </div>
  </body>
</html>

<script>
  document.addEventListener('astro:page-load', () => {
    const onIdle = (cb: () => void) =>
      (window.requestIdleCallback || ((cb) => setTimeout(cb, 150)))(cb);

    onIdle(() => {
      const added: Array<{ button: Element; handler: (e: Event) => void }> = [];
      const copyButtons = document.querySelectorAll(
        '.copy-button'
      ) as NodeListOf<HTMLButtonElement>;

      copyButtons.forEach((button) => {
        if (!button.dataset.code) {
          console.warn('Copy button without data-code attribute found:', button);
          return;
        }

        const timeouts: NodeJS.Timeout[] = [];
        const handler = () => {
          if (timeouts.length > 0) {
            timeouts.forEach((timeout) => clearTimeout(timeout));
          }

          navigator.clipboard.writeText(button.dataset.code || '');

          button.classList.add('keep-svg');
          button.classList.add('copied');

          // What if we still have timeouts and swap to another page?
          timeouts.push(
            setTimeout(() => {
              button.classList.remove('copied');
            }, 2000)
          );

          timeouts.push(
            setTimeout(() => {
              button.classList.remove('keep-svg');
            }, 1500)
          );
        };

        button.addEventListener('click', handler);
        added.push({ button, handler });
      });

      document.addEventListener('astro:before-swap', () => {
        added.forEach(({ button, handler }) => button.removeEventListener('click', handler));
      }, { once: true });
    });
  });
</script>
