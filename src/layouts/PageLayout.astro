---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  author?: string;
  type?: 'website' | 'article';
}

const { ...rest } = Astro.props as Props;
---

<BaseLayout {...rest}>
  <div class="pt-4 px-4 mx-auto max-w-screen-md text-sm">
    <slot />
  </div>
</BaseLayout>
