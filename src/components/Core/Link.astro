---
import { Icon } from "astro-icon/components";
import Element from "./Element.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<'a'> {}

const { class: classList = '', ...rest } = Astro.props as Props;
const remoteLink = rest.href?.toString().startsWith('http');
---

<Element 
  as="a" 
  class:list={{
    "flex flex-row gap-1 items-center group": remoteLink
  }}
  {classList} 
  {...rest}
>
  <slot/>
  {remoteLink && (
    <Icon
      name="lucide:arrow-up-right"
      class="text-flexoki-light-cy dark:text-flexoki-dark-cy duration-75 group-hover:translate-x-0.5 translate-y-0.5 group-hover:-translate-y-0"
    />
  )}
</Element>
