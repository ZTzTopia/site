---
import type { CollectionEntry } from 'astro:content';
import Card from './core/Card.astro';
import { getEventChallenges } from '../utils/content';
import { Icon } from 'astro-icon/components';
import { getBackgroundColorByCategory } from '../utils/color';

const { event, ...rest } = Astro.props as { event: CollectionEntry<'events'> };

const categoryIconMap: { [key: string]: string } = {
  crypto: 'lucide:lock',
  web: 'lucide:globe',
  pwn: 'lucide:skull',
  bin: 'lucide:skull',
  rev: 'lucide:eye',
  forensics: 'lucide:search',
  misc: 'lucide:apple',
};

const getIcon = (category: string) => {
  const categoryLowerCased = category?.toLowerCase() || '';
  const matchedKey = Object.keys(categoryIconMap).find((key) =>
    categoryLowerCased.includes(key)
  );

  return matchedKey ? categoryIconMap[matchedKey] : 'lucide:tag';
};

const challenges = await getEventChallenges(
  ({ id, data }) =>
    id.startsWith(event.id.split('/').slice(0, 2).join('/')) &&
    data.draft !== true
);

const flattenedCategories = [
  ...new Set(
    challenges.flatMap((challenge) => {
      if (challenge.data.categories.length < 1) {
        return [];
      }

      return challenge.data.categories
        .map((category) =>
          category === null || category === undefined || category.trim() === ''
            ? null
            : category.trim()
        )
        .filter(Boolean);
    })
  ),
];

const flattenedTags = [
  ...new Set(
    challenges.flatMap((challenge) => {
      if (challenge.data.tags.length < 1) {
        return [];
      }

      return challenge.data.tags
        .map((tag) =>
          tag === null || tag === undefined || tag.trim() === ''
            ? null
            : `#${tag.trim().toLowerCase()}`
        )
        .filter(Boolean);
    })
  ),
];

// event.data.start
// event.data.end
// Make like Jan 15 - 17, 2025 or Jan 28 - Feb 1 2025

const startDate = new Date(event.data.start);
const endDate = new Date(event.data.end);

const formatDateRange = (start: Date, end: Date) => {
  const options: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' };
  if (start.getFullYear() === end.getFullYear()) {
    options.year = undefined;
    options.month = 'short';
    options.day = 'numeric';
    options.hour = 'numeric';
    options.minute = 'numeric';
  }

  return `${start.toLocaleDateString(undefined, options)} - ${end.toLocaleDateString(undefined, options)}`;
};
---

<Card {...rest}>
  <Fragment slot="content">
    <div class="flex flex-col gap-2">
      <div class="flex flex-col">
        <p class="font-medium">{event.data.title}</p>
        <p class="text-flexoki-base-600 dark:text-flexoki-base-500">
          {event.data.description}
        </p>
      </div>
      <div class="flex flex-row gap-2">
        <p class="text-flexoki-base-600 dark:text-flexoki-base-500">
          <Icon name="lucide:calendar" class="inline-block mr-1" />
          {formatDateRange(startDate, endDate)}
        </p>
        <p class="text-flexoki-base-600 dark:text-flexoki-base-500">
          <Icon name="lucide:target" class="inline-block mr-1" />
          {challenges.length} challenge{challenges.length === 1 ? '' : 's'}
        </p>
        <p class="text-flexoki-base-600 dark:text-flexoki-base-500">
          <Icon name="lucide:user" class="inline-block mr-1" />
          Team
        </p>
      </div>
      {
        (flattenedCategories.length > 0 || flattenedTags.length > 0) && (
          <div class="flex flex-col gap-2">
            {flattenedCategories.length > 0 && (
              <div class="flex flex-row flex-wrap gap-2">
                {flattenedCategories.map((category) => (
                  <span
                    class={`flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded ${getBackgroundColorByCategory(category)}`}
                  >
                    <Icon name={getIcon(category)} />
                    {category}
                  </span>
                ))}
              </div>
            )}
            {flattenedTags.length > 0 && (
              <div class="flex flex-row flex-wrap gap-2">
                {flattenedTags.slice(0, 5).map((tag) => (
                  <span class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui">
                    {tag}
                  </span>
                ))}
                {flattenedTags.length > 5 && (
                  <span class="flex flex-row items-center gap-x-2 text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui">
                    +{flattenedTags.length - 5}
                  </span>
                )}
              </div>
            )}
          </div>
        )
      }
    </div>
  </Fragment>
</Card>
