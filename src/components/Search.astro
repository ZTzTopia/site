---
import { Icon } from 'astro-icon/components';
import Element from './core/Element.astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  placeholder?: string;
  value?: string;
}

const { placeholder = 'Search...', value = '', class: classList = '',...rest } = Astro.props as Props;
---

<Element
  as="form"
  class="flex items-center gap-2 rounded bg-flexoki-base-100 dark:bg-flexoki-base-900 border border-flexoki-base-200 dark:border-flexoki-base-800 px-3 py-2"
  role="search"
  {classList}
  {...rest}
  onsubmit="event.preventDefault();"
>
  <Icon
    name="lucide:search"
    class="text-flexoki-base-600 dark:text-flexoki-base-500 w-4 h-4"
  />
  <input
    type="search"
    name="q"
    class="bg-transparent outline-none border-none text-sm flex-1 text-flexoki-black dark:text-flexoki-base-200 placeholder:text-flexoki-base-400 dark:placeholder:text-flexoki-base-500"
    placeholder={placeholder}
    value={value}
  />
  <button
    type="button"
    aria-label="Clear search"
    class="ml-1 p-1 rounded hover:bg-flexoki-base-200 dark:hover:bg-flexoki-base-800"
    onclick="const input = this.parentNode.querySelector('input[type=search]'); input.value=''; input.dispatchEvent(new Event('input', { bubbles: true }));"
    style="display: {value ? 'inline-flex' : 'none'};"
  >
    <Icon
      name="lucide:x"
      class="text-flexoki-base-600 dark:text-flexoki-base-500 w-3 h-3"
    />
  </button>
</Element>

<style>
  input[type='search']::-webkit-search-cancel-button {
    display: none;
    -webkit-appearance: none;
  }

  input[type='search']::-ms-clear {
    display: none;
    width: 0;
    height: 0;
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus, 
  input:-webkit-autofill:active{
      /* Transparent */
      transition: background-color 5000s ease-in-out 0s;
  }
</style>
