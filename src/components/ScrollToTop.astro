---
import { Icon } from 'astro-icon/components';
import Button from './Core/Button.astro';
---

<Button
  variant="outline"
  size="icon"
  id="scroll-to-top"
  class="hidden fixed bottom-8 right-8 z-50"
>
  <Icon name="lucide:arrow-up" />
</Button>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const onIdle = (cb) =>
      (window.requestIdleCallback || ((cb) => setTimeout(cb, 150)))(cb);

    onIdle(() => {
      const scrollToTopButton = document.getElementById('scroll-to-top');
      if (!scrollToTopButton) return;

      const footer = document.querySelector('footer');
      if (!footer) return;

      const onClick = () => window.scrollTo({ top: 0, behavior: 'smooth' });
      const onScroll = () => {
        const footerVisible = footer.getBoundingClientRect().top <= window.innerHeight;
        const shouldShowButton = window.scrollY > 256 && !footerVisible;
        scrollToTopButton.classList.toggle('hidden', !shouldShowButton);
      };

      scrollToTopButton.addEventListener('click', onClick);
      window.addEventListener('scroll', onScroll);

      document.addEventListener('astro:before-swap', () => {
        scrollToTopButton.removeEventListener('click', onClick);
        window.removeEventListener('scroll', onScroll);
      }, { once: true });
    });
  });
</script>
