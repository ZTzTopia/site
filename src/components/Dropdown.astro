---
import type { HTMLAttributes } from 'astro/types';
import Element from './Core/Element.astro';
import Card from './Core/Card.astro';

interface Props extends HTMLAttributes<'div'> {
  position?: 'top' | 'bottom' | undefined;
  side?: 'left' | 'right' | undefined;
}

const {
  position = 'bottom',
  side = 'left',
  class: classList = '',
  ...rest
} = Astro.props as Props;
---

<Element as="z-dropdown" class:list="relative block" {classList} {...rest}>
  <slot name="trigger" />
  <Card
    class:list={[
      'hidden absolute w-max z-30',
      'bg-flexoki-base-100 dark:bg-flexoki-base-900 border border-flexoki-base-100 dark:border-flexoki-base-900',
      {
        'top-full mt-2': position === 'bottom',
        'bottom-full mb-2': position === 'top',
      },
      {
        'right-0': side === 'right',
        'left-0': side === 'left',
      },
    ]}
  >
    <slot />
  </Card>
</Element>

<script>
  class Dropdown extends HTMLElement {
    private _dropdownButtonTrigger: HTMLElement | null = null;
    private _onTriggerClick: ((e: Event) => void) | null = null;
    private _onDocClick: ((e: Event) => void) | null = null;
    private _inited = false;

    constructor() {
      super();

      const onIdle = (cb: () => void) =>
        (window.requestIdleCallback || ((cb) => setTimeout(cb, 150)))(cb);

      document.addEventListener('astro:page-load', () => onIdle(() => this.init()));
    }

    init() {
      if (this._inited) return;
      this._inited = true;

      this._dropdownButtonTrigger = this.children[0] as HTMLElement | null;
      if (!this._dropdownButtonTrigger) {
        return;
      }

      const dropdownContent = this.children[1];
      if (!dropdownContent) {
        return;
      }

      this._onTriggerClick = () => {
        dropdownContent?.classList.toggle('hidden');
      };

      this._onDocClick = (event: Event) => {
        if (!this._dropdownButtonTrigger) {
          return;
        }

        if (
          !this._dropdownButtonTrigger.contains(event.target as Node) &&
          !dropdownContent?.contains(event.target as Node)
        ) {
          dropdownContent?.classList.add('hidden');
        }
      };

      this._dropdownButtonTrigger.addEventListener('click', this._onTriggerClick);
      document.addEventListener('click', this._onDocClick);
      document.addEventListener('astro:before-swap', () => this.destroy(), { once: true });
    }

    destroy() {
      if (this._dropdownButtonTrigger && this._onTriggerClick) {
        this._dropdownButtonTrigger.removeEventListener('click', this._onTriggerClick);
        this._onTriggerClick = null;
      }

      if (this._onDocClick) {
        document.removeEventListener('click', this._onDocClick);
        this._onDocClick = null;
      }

      this._inited = false;
    }

    disconnectedCallback() {
      this.destroy();
    }
  }

  customElements.define('z-dropdown', Dropdown);
</script>
