---
import { SEO } from "astro-seo";
import { stripTrailingSlash } from '../utils/path';
import ThemeProvider from './ThemeProvider.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  nofollow?: boolean;
  image?: string;
  author?: string;
  type?: 'website' | 'article';
}

const { 
  title, 
  description, 
  nofollow = false,
  noindex = false,
  image = '',
  author = "ztz0",
  type = "website",
} = Astro.props as Props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const base = stripTrailingSlash(import.meta.env.BASE_URL);
const sitemap = `${base}/sitemap-index.xml`;

const ogImage = image !== '' && Astro.site 
  ? new URL(image.startsWith('/') ? image : `/${image}`, Astro.site).href
  : undefined;

const ldJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": type === "article" ? "TechArticle" : "WebPage",
  headline: title,
  description,
  image: ogImage,
  author: {
    "@type": "Person",
    name: author || "ztz0",
  },
  publisher: {
    "@type": "Person",
    name: "ztz0",
  },
});
---

<SEO
  title={title}
  titleTemplate="%s | ztz0"
  titleDefault="ztz0"
  charset="utf-8"
  description={description}
  canonical={canonical.href}
  nofollow={nofollow}
  noindex={noindex}
  openGraph={{
    basic: {
      title: title,
      type: type as string,
      image: ogImage ?? "",
      ...(canonical && { url: canonical.href }),
    }
  }}
  twitter={{
    card: ogImage ? "summary_large_image" : "summary",
    site: "@ztz0",
    creator: `@${author || "ztz0"}`,
    title: title,
    description: description,
    ...(ogImage && { image: ogImage }),
  }}
  extend={{
    link: [
      { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
      { rel: "alternate icon", type: "image/svg+xml", href: "/favicon.svg" },
    ],
    meta: [
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { name: "generator", content: Astro.generator },
    ],
  }}
/>
<script is:inline type="application/ld+json" set:html={ldJson} />
{Astro.site && <link rel="sitemap" href={sitemap} />}

<ThemeProvider />
<ClientRouter />
