---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { getBackgroundColorByCategory, getIconByCategory } from '../utils/color-icon';
import { getChallenges } from '../utils/content';
import Card from './Core/Card.astro';
import { normalizeCategoryName } from '../utils/helper';

const { event, ...rest } = Astro.props as { event: CollectionEntry<'events'> };

const challenges = await getChallenges(
  ({ id, data }) =>
    id.startsWith(event.id.split('/').slice(0, 2).join('/')) &&
    data.draft !== true
);

const flattenedCategories = [
  ...new Set(
    challenges.flatMap((challenge) => {
      if (challenge.data.categories.length < 1) {
        return [];
      }

      return challenge.data.categories
        .map((category) =>
          category === null || category === undefined || category.trim() === ''
            ? null
            : category.trim()
        )
        .filter(Boolean);
    })
  ),
];

const flattenedTags = [
  ...new Set(
    challenges.flatMap((challenge) => {
      if (challenge.data.tags.length < 1) {
        return [];
      }

      return challenge.data.tags
        .map((tag) =>
          tag === null || tag === undefined || tag.trim() === ''
            ? null
            : `#${tag.trim().toLowerCase()}`
        )
        .filter(Boolean);
    })
  ),
];

// event.data.start
// event.data.end
// Make like Jan 15 - 17, 2025 or Jan 28 - Feb 1 2025

const startDate = event.data.start ? new Date(String(event.data.start)) : null;
const endDate = event.data.end ? new Date(String(event.data.end)) : null;

const formatDateRange = (start: Date, end: Date) => {
  const options: Intl.DateTimeFormatOptions = {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  };
  if (start.getFullYear() === end.getFullYear()) {
    options.year = undefined;
    options.month = 'short';
    options.day = 'numeric';
    options.hour = 'numeric';
    options.minute = 'numeric';
  }

  return `${start.toLocaleDateString(undefined, options)} - ${end.toLocaleDateString(undefined, options)}`;
};
---

<Card {...rest}>
  <Fragment slot="content">
    <div class="flex flex-col gap-2">
      <div class="flex flex-col">
        <p class="font-medium">{event.data.title}</p>
        <p class="text-flexoki-base-600 dark:text-flexoki-base-500">
          {event.data.description}
        </p>
      </div>
      <div class="flex flex-col md:flex-row gap-2">
        <p class="flex flex-row flex-wrap items-center gap-1 text-flexoki-base-600 dark:text-flexoki-base-500">
          <Icon name="lucide:calendar" />
          {formatDateRange(startDate!, endDate!)}
        </p>
        <p class="flex flex-row flex-wrap items-center gap-1 text-flexoki-base-600 dark:text-flexoki-base-500">
          <Icon name="lucide:target" />
          {challenges.length} challenge{challenges.length === 1 ? '' : 's'}
        </p>
        <p class="flex flex-row flex-wrap items-center gap-1 text-flexoki-base-600 dark:text-flexoki-base-500">
          <Icon name="lucide:user" />
          Team
        </p>
      </div>
      {
        (flattenedCategories.length > 0 || flattenedTags.length > 0) && (
          <div class="flex flex-col gap-2">
            {flattenedCategories.length > 0 && (
              <div class="flex flex-row flex-wrap gap-2">
                {flattenedCategories.map((category) => (
                  <span
                    class={`flex flex-row items-center gap-x-1 text-xs font-medium px-2.5 py-0.5 rounded ${getBackgroundColorByCategory(category!)}`}
                  >
                    <Icon name={getIconByCategory(category!)} />
                    {normalizeCategoryName(category!)}
                  </span>
                ))}
              </div>
            )}
            {flattenedTags.length > 0 && (
              <div class="flex flex-row flex-wrap gap-2">
                {flattenedTags.slice(0, 5).map((tag) => (
                  <span class="flex flex-row items-center text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui">
                    {tag}
                  </span>
                ))}
                {flattenedTags.length > 5 && (
                  <span class="flex flex-row items-center text-xs font-medium px-2.5 py-0.5 rounded bg-flexoki-light-ui dark:bg-flexoki-dark-ui">
                    +{flattenedTags.length - 5}
                  </span>
                )}
              </div>
            )}
          </div>
        )
      }
    </div>
  </Fragment>
</Card>
