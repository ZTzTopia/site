---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';
import Card from './core/Card.astro';

interface Props extends HTMLAttributes<'div'> {
  icon?: string;
}

const { icon = 'lucide:moon', ...rest } = Astro.props as Props;
---

<Card
  {...rest}
>
  <div slot="content" class="flex gap-2 items-center">
    <div class="p-3 bg-flexoki-light-ui-2 dark:bg-flexoki-dark-ui-2 rounded-full">
      <Icon name={icon} class="w-4 h-4" />
    </div>
    <slot />
  </div>
</Card>
